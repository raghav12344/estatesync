<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color:#F4F8FF;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dealsFinder.dealsFinderController">


    <children>

        <VBox spacing="20" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="20.0">


            <children>


                <!-- Header -->

                <AnchorPane prefHeight="75" style="-fx-background-color:linear-gradient(to right,#1767FF,#0A4ED9);                                    -fx-background-radius:15;">

                    <children>

                        <Label layoutX="500" layoutY="20" style="-fx-text-fill:white;                                       -fx-font-size:30px;                                       -fx-font-weight:bold;" text="🤝 Deal List" />

                    </children>

                </AnchorPane>



                <!-- Filter Section -->

                <VBox spacing="15" style="-fx-background-color:white;                              -fx-background-radius:20;                              -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.2),10,0,0,3);">


                    <padding>
                        <Insets bottom="20" left="25" right="25" top="20" />
                    </padding>


                    <children>


                        <HBox alignment="CENTER_LEFT" spacing="30">


                            <children>


                                <Label prefWidth="100" style="-fx-font-size:16px;                                               -fx-font-weight:bold;" text="Deal Status" />


                                <RadioButton fx:id="pending" prefWidth="90" text="Pending" />


                                <RadioButton fx:id="finalized" prefWidth="100" text="Completed" />



                                <Label prefWidth="140" style="-fx-font-size:16px;                                               -fx-font-weight:bold;" text="Registration After" />



                                <DatePicker fx:id="regDate" prefWidth="180" />



                                <Button fx:id="btnFetch" onAction="#fetchDeals" prefHeight="40" prefWidth="150" style="-fx-background-color:#1767FF;                                                -fx-text-fill:white;                                                -fx-font-weight:bold;                                                -fx-background-radius:15;" text="🔍 Fetch Detail" />


                            </children>


                        </HBox>


                    </children>


                </VBox>





                <!-- Table -->

                <VBox style="-fx-background-color:white;                              -fx-background-radius:20;                              -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.2),10,0,0,3);" VBox.vgrow="ALWAYS">


                    <children>


                        <TableView fx:id="dealTable" VBox.vgrow="ALWAYS" />


                    </children>


                </VBox>





                <!-- Bottom Buttons -->


                <HBox alignment="CENTER" spacing="150">


                    <children>


                        <Button fx:id="btnExcel" onAction="#exporttoexcel" prefHeight="45" prefWidth="220" style="-fx-background-color:white;                                        -fx-border-color:#1767FF;                                        -fx-border-width:2;                                        -fx-border-radius:18;                                        -fx-background-radius:18;                                        -fx-text-fill:#1767FF;                                        -fx-font-size:16;                                        -fx-font-weight:bold;" text="📊 Export Excel" />



                        <Button fx:id="btnPdf" onAction="#createPdf" prefHeight="45" prefWidth="220" style="-fx-background-color:#1767FF;                                        -fx-text-fill:white;                                        -fx-background-radius:18;                                        -fx-font-size:16;                                        -fx-font-weight:bold;" text="📄 Generate PDF" />


                    </children>


                </HBox>



            </children>


        </VBox>


    </children>


</AnchorPane>
